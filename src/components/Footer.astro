---

<footer>
  <h2>Ask<span>Experts</span></h2>
  <p>©2026 Consultalk. All rights reserved</p>
  <p>Terms of Service | Privacy Policy</p>
</footer>

<style>
  @layer components {
    footer {
      grid-column: full;

      display: grid;
      /* Bruger samme grid-layout som body */
      grid-template-columns: subgrid;

      align-items: center;

      height: 120px;
      padding-inline: var(--content-column);

      background-color: var(--color-ui-primary);

      h2 {
        grid-column: content-start / middle;
        grid-row: 1;
        color: var(--color-on-ui-primary);
        font-size: var(--font-size-logo);
      }

      span {
        color: var(--color-action);
      }

      p {
        color: var(--color-text-weak);
        font-size: var(--text-s);
      }

      h2 + p {
        grid-column: content-start / content-end;
        justify-self: center;
        grid-row: 1;
      }

      p + p {
        grid-column: middle / content-end;
        justify-self: end;
        grid-row: 1;
      }
    }
  }
</style>
