---
//@ts-nocheck
import ServiceCard from "@components/ServiceCard.astro";

const serviceData = await fetch("https://ftk-api.pages.dev/services").then(
  (res) => res.json(),
);
---

<div class="services">
  {serviceData.map((service) => <ServiceCard service={service} />)}
</div>

<style>
  @layer components {
    .services {
      grid-column: content-start / content-end;
      grid-row: 2 / 4;

      display: flex;
      gap: 1rem;

      align-self: flex-start;
    }

    .services > :global(article) {
      flex: 1 1 0;
    }
  }
</style>
