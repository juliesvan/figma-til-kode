---
import { Image } from "astro:assets";
import Services from "./Services.astro";
import CEOImage from "@assets/images/ceo.webp";
---

<section class="hero">
  <div class="hero-content">
    <h1>Empowering Your Business Growth</h1>
    <p>
      Discover tailored strategies and expert insights to take your business to
      the next level. Let us help you navigate challenges and achieve
      sustainable success.
    </p>
    <a href="#0">Book a Meeting</a>
    <a href="#0">Learn More</a>
  </div>
  <Image src={CEOImage} alt="CEO" />

  <Services />
</section>

<style>
  /* Styles her */
  @layer components {
    .hero {
      background-color: var(--color-ui-primary);
      color: var(--color-on-ui-primary);

      padding: 2rem;

      grid-column: full;
      grid-row: 1 / span 3;
      display: grid;
      grid-template-columns: subgrid;
      grid-template-rows: auto 5rem 1fr;

      img {
        grid-column: middle / full-end;
        grid-row: 1 / 3;

        /* width */
        inline-size: 100%;
        /* height */
        block-size: 100%;
        object-fit: cover;
      }
    }

    .hero-content {
      grid-column: content-start / middle;

      display: grid;
      grid-template-columns: 1fr 1fr;
      column-gap: 1rem;
      align-content: center;

      /* display: flex;
      flex-direction: column;
      justify-content: center; */

      max-width: 25rem;

      p {
        color: var(--color-on-ui-primary-muted);
      }

      h1,
      p {
        grid-column: 1 / -1;
      }

      /* Fælles styling af knapper */
      a {
        display: inline-block;
        padding: var(--padding-btns);
        border-radius: var(--border-radius-btns);
        font-weight: var(--font-weight-btns);
        width: 186px;
        text-align: center;
      }

      /* Styling af den første knap */
      p + a {
        background-color: var(--color-action);
        color: var(--color-text);
      }

      /* Styling af den anden knap */
      a + a {
        background-color: var(--color-ui-primary);
        border: 1px solid rgba(255, 255, 255, 0.5);
        color: var(--color-surface-primary);
      }
    }
  }
</style>
