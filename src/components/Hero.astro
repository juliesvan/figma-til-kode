---
import { Image } from "astro:assets";
import Services from "./Services.astro";
import CEOImage from "@assets/images/ceo.webp";

// Ikoner
import ArrowRight from "@icons/arrow--right.svg";
---

<section class="hero">
  <div class="hero-content">
    <h1><span>Empowering</span> Your Business Growth</h1>
    <p>
      Discover tailored strategies and expert insights to take your business to
      the next level. Let us help you navigate challenges and achieve
      sustainable success.
    </p>
    <a href="#0">Book a Meeting</a>
    <a href="#0">Learn More <ArrowRight class="arrow" /></a>
  </div>
  <Image src={CEOImage} alt="CEO" />

  <Services />
</section>

<style>
  /* Styles her */
  @layer components {
    .hero {
      background-color: var(--color-ui-primary);
      color: var(--color-on-ui-primary);

      /* padding: 2rem; */

      grid-column: full;
      grid-row: 1 / span 3;
      display: grid;
      grid-template-columns: subgrid;
      grid-template-rows: auto 1rem 1fr;

      img {
        grid-column: middle / full-end;
        grid-row: 1 / -1;

        inline-size: 100%;
        block-size: 100%;
        object-fit: cover;
      }
    }

    .hero-content {
      grid-column: content-start / middle;

      display: grid;
      grid-template-columns: 1fr 1fr;
      column-gap: 1rem;
      align-content: end;

      margin-top: 8rem;

      max-width: var(--max-width-text-content);

      h1 span {
        position: relative;
        isolation: isolate;

        &::after {
          position: absolute;
          content: "";
          display: block;

          right: 0;
          /* calc bruges til at udregne bredden på stregen. 50vw, så den fylder halvdelen af viewporten, og + 50% af det element stregen er positioneret i forhold til (i dette tilfælde er det h1's bredde). Så regnestykket bliver: halvdelen af viewportens bredde + 50% af elementets størrelse. */
          width: calc(50vw + 50%);
          height: 0.4rem;
          bottom: 0;

          background: linear-gradient(
            to right,
            transparent 0%,
            var(--color-action) 80%
          );

          z-index: -1;
        }
      }

      h1 {
        font-size: var(--heading-l);
      }

      p {
        color: var(--color-on-ui-primary-muted);
        font-size: var(--text-l);
      }

      h1,
      p {
        grid-column: 1 / -1;
      }

      /* Fælles styling af knapper */
      a {
        display: inline-block;
        padding: var(--padding-btns);
        border-radius: var(--border-radius-btns);
        font-weight: var(--font-weight-btns);
        font-size: var(--font-size-btns);
        width: 11rem;
        text-align: center;
      }

      /* Styling af den første knap */
      p + a {
        background-color: var(--color-action);
        color: var(--color-text);
      }

      p + a:hover {
        background-color: hsl(from var(--color-action) h s calc(l + 8));
      }

      /* Styling af den anden knap */
      a + a {
        display: inline-flex;
        gap: 0.5rem;
        align-items: center;
        justify-content: center;
        background-color: var(--color-ui-primary);
        border: 1px solid rgba(255, 255, 255, 0.5);
        color: var(--color-surface-primary);
      }

      .arrow {
        width: 1rem;
        height: 1rem;
      }
    }
  }
  /* Flow Space */
  .hero-content > * + * {
    margin-block-start: var(--flow-space-s);
  }

  .hero-content p + a {
    margin-block-start: var(--flow-space-l);
  }

  .hero-content a + a {
    margin-block-start: var(--flow-space-l);
  }
</style>
