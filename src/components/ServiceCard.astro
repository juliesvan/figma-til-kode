---
const { service } = Astro.props;
import ArrowRight from "@icons/arrow--right.svg";
---

<article>
  <h2>{service.title}</h2>
  <p>{service.description}</p>
  <a href="#0">{service.buttonText} <ArrowRight stroke-width={2.5} /></a>
  <!-- <a> burde måske være en variant af en component -->
</article>

<style>
  @layer components {
    article {
      display: flex;
      flex-direction: column;

      background: var(--color-blue-700-transparent);
      color: var(--color-on-surface-elevated);
      padding: var(--padding-cards); /* Dette burde være en token */
      border-radius: var(--border-radius-cards); /* Dette burde være en token */

      h2 {
        font-size: 1.5625rem;
      }
    }
    a {
      display: inline flex;
      gap: 1ch;
      color: var(--color-action);
      font-weight: bold;
      margin-top: auto;
      padding-top: 2rem;

      svg {
        inline-size: 16px;
      }
    }
  }
</style>
