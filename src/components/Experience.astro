---
import { getExperience } from "../lib/api.js";
const experience = await getExperience();
---

<section class="exp-container">
  <div class="exp-content">
    <p class="eyebrow">{experience.eyebrow}</p>
    <h2>{experience.title}</h2>
    <p>{experience.subtitle}</p>
  </div>
  <div class="exp-diagrams">
    {
      experience.stats.map((stat) => (
        <figure data-value={stat.value}>
          <svg viewBox="0 0 100 100">
            <circle class="track" />
            <circle class="progress" pathLength="100" />
            <circle class="marker" />
          </svg>
          <h3>{stat.label}</h3>
        </figure>
      ))
    }
  </div>
</section>

<style>
  @layer components {
    @property --progress {
      syntax: "<number>";
      inherits: true;
      initial-value: 0;
    }

    .exp-container {
      grid-column: full;
      display: grid;
      grid-template-columns: subgrid;

      background-color: var(--color-surface-highlight);
      padding-block: var(--padding-section-block);
      border: 1px solid #000;

      color: var(--color-text);
    }

    .exp-content {
      grid-column: content-start / middle;

      max-width: var(--max-width-text-content);

      h2 {
        font-size: var(--heading-m);
      }

      h2 + p {
        font-size: var(--text-s);
      }
    }

    .exp-diagrams {
      grid-column: middle / content-end;

      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 1.5rem;

      h3 {
        font-size: var(--heading-xs);
      }
    }

    figure {
      flex: 0 0 10rem;
      width: 10rem;
      min-inline-size: 0;
      text-align: center;

      --value-string: attr(data-value);
      --value-number: attr(data-value number);
      --value-percent: attr(data-value %);

      display: grid;
      grid: "stack";
      container: stat / inline-size;
      place-items: center;
    }

    figure::after {
      content: var(--value-string) "%";
      grid-area: stack;
      font-size: var(--font-size-heading-04);
      font-weight: 700;
    }

    svg {
      grid-area: stack;
      width: 100%;
      aspect-ratio: 1;
      rotate: -90deg;
    }

    .track {
      stroke: #daae3c;
    }

    .track,
    .progress {
      cx: 50;
      cy: 50;
      r: 46;
      fill: none;
      stroke-width: 4;
    }

    .progress {
      stroke: #fff;
      stroke-linecap: round;

      stroke-dasharray: 100.1;
      stroke-dashoffset: calc(100 - var(--value-number));
    }

    .marker {
      r: 4;
      fill: #000;
      stroke: #fff;
      stroke-width: 0.15rem;
      offset-path: circle(46px at 50px 50px);
      offset-distance: var(--value-percent);
    }
  }

  /* Flow Space */
  .exp-content > * + * {
    margin-block-start: var(--flow-space-s);
  }

  .exp-diagrams h3 {
    margin-block-start: var(--flow-space);
  }
</style>
